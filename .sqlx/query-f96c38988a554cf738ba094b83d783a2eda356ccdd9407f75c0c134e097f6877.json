  "query": "\n            SELECT i.id, i.symbol, i.asset_class AS \"asset_class: AssetClass\",\n                   i.currency, i.exchange, i.name\n            FROM position_group_members m\n            JOIN instruments i ON i.id = m.instrument_id\n            WHERE m.group_id = ?\n            ORDER BY i.symbol\n            ",
