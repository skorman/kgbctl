  "query": "\n            SELECT g.name, p.id AS \"position_id!\"\n            FROM position_groups g\n            JOIN position_group_members m ON m.group_id = g.id\n            JOIN positions p              ON p.instrument_id = m.instrument_id AND p.quantity != 0\n            ORDER BY g.id, p.id\n            ",
